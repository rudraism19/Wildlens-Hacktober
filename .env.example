# WildLens Environment Variables

# Google Gemini API key (Used server-side only for Gemini fallback)
# Never exposed in client bundles
GEMINI_API_KEY=

# Default AI provider mode ("gemma" | "gemini")
NEXT_PUBLIC_AI_MODE=gemma

# Application Name
NEXT_PUBLIC_APP_NAME=WildLens

# Optional Gemma inference endpoint (HuggingFace / Ollama / Local Vertex Gemma)
GEMMA_ENDPOINT_URL=
GEMMA_API_TOKEN=
